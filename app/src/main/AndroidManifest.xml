<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for clone / fetch / push / pull over the network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Storage. By default repos live in the app's own external files folder, which needs no
        permission at all. The three permissions below only matter if the person opts into the
        PUBLIC folder (/storage/emulated/0/.Graft) in Settings - see data/RepoStorage.kt.
        On Android 11+ that needs the "All files access" special permission, granted by hand in
        system Settings (there is no runtime popup for it); on Android 10 and below the classic
        WRITE_EXTERNAL_STORAGE permission is enough.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        Lets the system installer treat an APK handed to it by this app (via
        FileProvider, from the Actions screen's "Build outputs" → Install
        button) as a normal install source, instead of blocking it as an
        "unknown app" the way a plain file manager tap would be. Required on
        Android 8+ (API 26+); the system still shows its own confirmation
        dialog before anything installs, this just lets that dialog appear
        in the first place.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Android 13+ (API 33+) requires this runtime permission before any
        notification can be shown — including the background sync summary
        notification (see sync/SyncNotifier.kt). Requested from
        SettingsScreen when the person turns background sync on, since
        SyncWorker itself runs headless with no Activity to prompt from.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Transfers (clone / pull / push) run in a foreground service so they keep going - with a
        progress notification - when the app is backgrounded. Android 14+ requires the specific
        foreground-service type permission as well. See transfer/TransferService.kt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Graft"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Graft">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                graft:// deep links — jump straight into a specific repo or its
                Actions screen instead of always landing on the repo list. Used by
                sync/SyncNotifier.kt so tapping a notification opens the exact repo
                it's about, and available for anything else that wants to link
                directly into the app (a share, a shortcut, adb, etc.).
                graft://repo/{id} opens that repo's Overview; .../actions opens its
                Actions screen - see ui/navigation/AppNavHost.kt.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="graft" android:host="repo" />
                <data android:scheme="graft" android:host="transfers" />
            </intent-filter>
        </activity>

        <!-- Keeps transfers alive in the background; see transfer/TransferService.kt -->
        <service
            android:name=".transfer.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Scoped only to the apk-downloads folders (see res/xml/file_paths.xml and
            data/RepoStorage.apkDownloadsDir / data/ApkInstaller.kt) - not all of shared
            storage - so a content:// grant handed to the system installer can't be used
            to reach anything else on the device.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
